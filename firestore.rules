rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Safely get the calling user's role without crashing if they are brand new
    function getRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType : 'none';
    }

    // --- ROLE INVITATIONS ---
    match /role_invitations/{emailId} {
      allow read: if request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == emailId;
      allow write: if request.auth != null && (getRole() == 'velaarAdmin' || getRole() == 'admin');
    }

    // --- 1. USER PROFILES ---
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can create their own profile securely
      allow create: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.userType == (
          (request.auth.token.email != null && exists(/databases/$(database)/documents/role_invitations/$(request.auth.token.email.lower()))) ?
          get(/databases/$(database)/documents/role_invitations/$(request.auth.token.email.lower())).data.userType : 'pending'
        )
      );

      // Users can update their own profile, but cannot escalate privileges
      allow update: if request.auth != null && request.auth.uid == userId && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType', 'institutionId', 'collegeName']));

      // Admins, HOD, Registrar, ExamController, and TEACHERS can read all user profiles
      // (Teachers need to read student profiles to populate marks tables)
      allow read: if request.auth != null && (
        getRole() == 'velaarAdmin' ||
        getRole() == 'admin' ||
        getRole() == 'hod' ||
        getRole() == 'registrar' ||
        getRole() == 'examController' ||
        getRole() == 'teacher'
      );

      // Only admins can write other user profiles
      allow write: if request.auth != null && (
        getRole() == 'velaarAdmin' ||
        getRole() == 'admin'
      );
    }

    // --- 2. COURSES ---
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (getRole() == 'teacher' || getRole() == 'velaarAdmin');
    }

    // --- 3. SYLLABUS ---
    match /syllabus/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getRole() == 'teacher';
    }

    // --- 4. INSTITUTION ---
    match /institutions/{instId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        getRole() == 'velaarAdmin' ||
        getRole() == 'admin' ||
        getRole() == 'setup'
      );
    }

    // --- 5. ATTENDANCE SESSIONS ---
    match /attendance_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getRole() == 'teacher';
    }

    // --- 6. ATTENDANCE LOGS ---
    match /attendance_logs/{logId} {
      allow read: if request.auth != null && (
        getRole() == 'teacher' || request.auth.uid == resource.data.studentId
      );
      allow write: if request.auth != null && getRole() == 'student' && request.resource.data.studentId == request.auth.uid;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
